# ============================================================
# Clinora — Environment Configuration
# Copy to .env and fill in values before running locally.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_ENV=development              # development | production | test
SECRET_KEY=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clinora:clinora@localhost:5432/clinora
DATABASE_ECHO=false              # Set true to log all SQL (development only)

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Storage ---
STORAGE_BACKEND=local            # local | s3 (s3 adapter available in Phase 5)
STORAGE_LOCAL_ROOT=./storage/uploads

# --- Seeding (used by scripts/seed.py) ---
SEED_ADMIN_EMAIL=admin@clinora.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ORG_NAME=Clinora Clinic
SEED_ORG_SLUG=clinora
